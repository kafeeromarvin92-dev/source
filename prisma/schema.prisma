generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

enum ChallengeStatus {
  OPEN
  ACCEPTED
  REVIEW
  DISPUTED
  SETTLED
  CANCELLED
}

enum DecisionStatus {
  PENDING
  AI_RECOMMENDED
  DISPUTED
  ADMIN_DECIDED
  SETTLED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id            String        @id @default(cuid())
  username      String        @unique
  teamName      String
  email         String        @unique
  passwordHash  String
  avatar        String
  isAdmin       Boolean       @default(false)
  bio           String?
  gameTags      String        @default("DLS")
  country       String?
  createdAt     DateTime      @default(now())
  lastSeenAt    DateTime?
  sessions      Session[]
  created       Challenge[]   @relation("createdChallenges")
  accepted      Challenge[]   @relation("acceptedChallenges")
  messages      MatchMessage[]
  codes         PlayerCode[]
  submissions   Submission[]
  objections    Objection[]
  decisions     MatchDecision[] @relation("adminDecisions")
  wonDecisions  MatchDecision[] @relation("winnerDecisions")
  notifications Notification[]
  sentFriendRequests FriendRequest[] @relation("sentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("receivedFriendRequests")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  kind      String   @default("INFO")
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id          String           @id @default(cuid())
  requesterId String
  recipientId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  requester   User             @relation("sentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User             @relation("receivedFriendRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Challenge {
  id          String          @id @default(cuid())
  verified    Boolean         @default(false)
  status      ChallengeStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  creatorId   String
  acceptedById String?
  creator     User            @relation("createdChallenges", fields: [creatorId], references: [id])
  acceptedBy  User?           @relation("acceptedChallenges", fields: [acceptedById], references: [id])
  messages    MatchMessage[]
  codes       PlayerCode[]
  submissions Submission[]
  decision    MatchDecision?
  objections  Objection[]
}

model MatchMessage {
  id          String    @id @default(cuid())
  challengeId String
  senderId    String
  text        String
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  sender      User      @relation(fields: [senderId], references: [id])
}

model PlayerCode {
  id          String    @id @default(cuid())
  challengeId String
  playerId    String
  code        String
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  player      User      @relation(fields: [playerId], references: [id])
  @@unique([challengeId, playerId])
}

model Submission {
  id          String    @id @default(cuid())
  challengeId String
  playerId    String
  image       String
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  player      User      @relation(fields: [playerId], references: [id])
  @@unique([challengeId, playerId])
}

model MatchDecision {
  id             String         @id @default(cuid())
  challengeId    String         @unique
  status         DecisionStatus @default(PENDING)
  winnerId       String?
  proposedWinnerId String?
  confirmedById  String?
  confirmedAt    DateTime?
  confidence     Int?
  reasoning      String?
  creatorScore   Int?
  acceptedByScore Int?
  decidedById    String?
  decidedAt      DateTime?
  challenge      Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  winner         User?          @relation("winnerDecisions", fields: [winnerId], references: [id])
  decidedBy      User?          @relation("adminDecisions", fields: [decidedById], references: [id])
}
model Objection {
  id          String    @id @default(cuid())
  challengeId String
  playerId    String
  reason      String
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  player      User      @relation(fields: [playerId], references: [id])
}
